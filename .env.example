# ─── Resend (https://resend.com) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=you@yourdomain.com
FROM_EMAIL=noreply@yourdomain.com

# ─── Supabase (https://supabase.com) ───────────────────────────────────────
# From: Project Settings → API
REACT_APP_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Used only in the serverless function (never exposed to browser)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Admin Panel ───────────────────────────────────────────────────────────
# Set a strong password — this protects your /admin page
ADMIN_PASSWORD=your_strong_password_here
